# ==============================================================================
# Git Ignore - Nexo Download Pro (Exclusivo do Aplicativo Desktop)
# ==============================================================================

# Executáveis grandes e diretórios de build
dist/
build/
bin/*.exe
tools/**/ffmpeg.exe
tools/**/ffprobe.exe

# Binários C gerados localmente e intermediários de compilação
*.pyd
*.obj
*.lib
*.exp
*.c

# Cache Python & Testes
__pycache__/
*.py[cod]
*$py.class
*.spec.bak
.pytest_cache/
.pytest_temp/

# Perfil temporário do WebView2 e logs
.app_profile/
*.log
*.tmp

# Downloads do usuário
downloads/

# Módulo de Áudio - Arquivos de runtime e workspaces temporários
audio_engine/outputs/
audio_engine/training_workspace/
audio_engine/modelos/*.pth
audio_engine/modelos/*.index
!audio_engine/modelos/.gitkeep

# Dados gerados em tempo de execução
transcricoes/

# IDE e sistema operacional
.vscode/
.idea/
Thumbs.db
Desktop.ini
