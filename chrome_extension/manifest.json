{
  "manifest_version": 3,
  "name": "YouTube Study Intelligence (Padrão Diamante)",
  "version": "1.0.0",
  "description": "Painel de Estudos com Transcrição Sincronizada, Método Cornell e Busca Instantânea integrado nativamente ao YouTube.",
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir Painel de Estudos Lateral"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
